<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard Ferretería</title> 
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-chart-radial-gauge@^0.3.0/dist/chartjs-chart-radial-gauge.min.js"></script>
  <%= favicon_link_tag 'favicon.png' %>
  <%= stylesheet_link_tag "dashboard", media: "all" %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Eczar:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap" rel="stylesheet">

  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  <%= javascript_importmap_tags %>
</head>
<body>

  <header>
    <div class="container-header">
      <button class="hamburger" id="hamburger">&#9776;</button>
      <div id="control">
        <div class="panel"><%= image_tag "panel-control.png", class: "c-panel" %></div>
        <p class="pricipal">Panel de Control</p>
      </div>
      <% if user_signed_in? %>
        <%= link_to root_path, id: "cerrar", class: "logout2" do %>
          <span><i class="fas fa-arrow-left"></i></span>
        <% end %>
      <% end %>
    </div>
  </header>

  <nav class="nav-bg">
    <div class="container-nav">
      <ul class="menu" id="menu">
        <li><a href="#"class="link-menu">Inicio</a></li>
        <li><a href="/dashboard/productos"class="link-menu">Productos</a></li>
        <li><a href="/dashboard/ventas"class="link-menu">Ventas</a></li>
        <li><a href="/dashboard/pedidos"class="link-menu">Pedidos</a></li>
        <%# <li><a href="dashboard/suppliers"class="link-menu">Proveedores</a></li> %>
        <%# <li><a href="/dashboard/clientes"class="link-menu">Clientes</a></li> %>
        <li><a href="/dashboard/help"class="link-menu">Ayuda</a></li>
      </ul>
      <% if user_signed_in? %>
        <%= link_to "Ir a Inicio", root_path, id: "cerrar", class: "logout" %>
      <% end %>
    </div>
  </nav>

  <section class="fondo">
    <section class="section-1">
      <div class="grafica-1">
        <section class="graf-1">
          <canvas id="graficoClientesMes"></canvas>
        </section>
        <section class="texto-1">
          <div class="titulo-1">Registros de clientes nuevos</div>
          <div class="texto-1-1">Este dato permite visualizar la evolución del negocio y el ritmo con el que se incrementa la cantidad
             de personas que acceden por primera vez a nuestros productos y servicios.</div>
        </section>
      </div>
      <div class="grafica-2">
        <section class="texto-2">
          <section class="texto-2-1"><div class="titulo-2">Ventas por categoría de producto</div>Este gráfico presenta la distribución de
            ventas por categorías de productos, permitiendo identificar cuáles generan mayores ingresos y aportan más al rendimiento general del negocio.
          </section>
          <div class="img-2">
            <canvas id="gaugeSegmentado"></canvas>
            <div class="gauge-value">Stock<br>90%</div>
          </div>
        </section>
        <section class="graf-2">
          <canvas id="graficoVentas" ></canvas>
        </section>
      </div>
      <div class="grafica-3">
        <section>
          <div class="ingresos">
            <p class="flecha" id="F1">🡅</p>
            <p class="etiqueta">Ingresos Totales</p>
            <p class="monto" id="ingresos">0$</p>
          </div>
        </section>
      </div>
    </section>

    <section class="section-2">
      <div class="grafica-4">
        <section class="graf-4-2">
          <div class="titulo-4-2">Ventas por Método de Pago</div>
          <canvas id="graficoPago"></canvas>
        </section>
      </div>
      <div class="grafica-5">
        <section class="texto-5"><div class="titulo-5">Ventas por día / semana / mes</div>Esta sección muestra el total de ventas realizadas durante el periodo 
        seleccionado (diario, semanal o mensual). La información permite identificar tendencias, evaluar el rendimiento y apoyar la toma de decisiones estratégicas.</section>

        <section class="graf-5">

          <!-- Dia -->
          <div class="grafico">
            <canvas id="grafDia" width="120" height="120"></canvas>
          </div>

          <!--Semana -->
          <div class="grafico">
            <canvas id="grafSemana" width="120" height="120"></canvas>
          </div>

          <!-- Mes -->
          <div class="grafico">
            <canvas id="grafMes" width="120" height="120"></canvas>
          </div>

        </section>

      </div>
    </section>
  </section>

  <footer>
    &copy; 2025 Ferremateriales el Maestro - v3.8.5
  </footer>

  <!-- grfaica de la seccion 1 -->
<script>
  const chartInstances = {};
  const apiCache = {};
  
  function limpiarCache() {
    Object.keys(apiCache).forEach(key => delete apiCache[key]);
  }
  
  function fetchConCache(url) {
    return fetch(url)
      .then(res => res.json());
  }
  
  function cargarGraficos() {
    // Precarga de datos en paralelo
    Promise.all([
      fetchConCache('/api/v1/clientes_por_mes').catch(e => { console.error('Error clientes:', e); return {}; }),
      fetchConCache('/api/v1/dashboard/porcentaje_stock').catch(e => { console.error('Error stock:', e); return {porcentaje: 0}; }),
      fetchConCache('/api/v1/ventas_por_categoria').catch(e => { console.error('Error categoría:', e); return {etiquetas: [], valores: []}; }),
      fetchConCache('/api/v1/finanzas').catch(e => { console.error('Error finanzas:', e); return {ingresos: 0, egresos: 0}; }),
      fetchConCache('/api/v1/ventas_por_metodo_pago').catch(e => { console.error('Error pago:', e); return {etiquetas: [], valores: []}; }),
      fetchConCache('/api/v1/ventas_periodo').catch(e => { console.error('Error periodo:', e); return {dia: 0, semana: 0, mes: 0}; })
    ])
    .then(([clientesMes, stock, ventasCategoria, finanzas, ventasPago, ventasPeriodo]) => {
      // Usar requestAnimationFrame para mejor rendimiento
      requestAnimationFrame(() => {
        if (document.getElementById('graficoClientesMes') && clientesMes) crearGraficoClientesMes(clientesMes);
      });
      
      requestAnimationFrame(() => {
        if (document.getElementById('gaugeSegmentado') && stock) crearGaugeStock(stock);
      });
      
      requestAnimationFrame(() => {
        if (document.getElementById('graficoVentas') && ventasCategoria) crearGraficoVentas(ventasCategoria);
      });
      
      if (finanzas) {
        const el = document.getElementById("ingresos");
        if (el) el.textContent = formatearPesos(finanzas.ingresos || 0);
      }
      
      // Renderizar gráficos secundarios después
      setTimeout(() => {
        requestAnimationFrame(() => {
          if (document.getElementById('graficoPago') && ventasPago) crearGraficoPago(ventasPago);
        });
        
        requestAnimationFrame(() => {
          if (document.getElementById('grafDia')) crearDoughnut('grafDia', ventasPeriodo.dia || 0, 'Día');
          if (document.getElementById('grafSemana')) crearDoughnut('grafSemana', ventasPeriodo.semana || 0, 'Semana');
          if (document.getElementById('grafMes')) crearDoughnut('grafMes', ventasPeriodo.mes || 0, 'Mes');
        });
      }, 50);
    })
    .catch(error => console.error("Error general:", error));
  }
  
  // Ejecutar al cargar la página
  document.addEventListener('DOMContentLoaded', cargarGraficos);
  
  // Actualizar cuando se regresa a esta vista (para navegación dinámica)
  window.addEventListener('popstate', cargarGraficos);
  
  // Si usas navegación AJAX, escucha cambios en el historial
  if (window.history && window.history.pushState) {
    const originalPushState = window.history.pushState;
    window.history.pushState = function() {
      originalPushState.apply(this, arguments);
      if (window.location.pathname === '/' || window.location.pathname.includes('dashboard')) {
        limpiarCache();
        cargarGraficos();
      }
    };
  }

  function formatearPesos(valor) {
    return `$${valor.toLocaleString("es-CO")}`;
  }

  function crearGraficoClientesMes(data) {
    if (chartInstances.clientes) chartInstances.clientes.destroy();
    
    const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
      'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    const valores = Object.values(data);
    const etiquetas = Object.keys(data).map(num => meses[parseInt(num) - 1]);
    const valoresFiltrados = valores.filter(v => v > 0);
    const etiquetasFiltradas = etiquetas.filter((_, i) => valores[i] > 0);
    const colores = ['#1e88e5', '#103f91', '#1565c0', '#1976d2', '#2196f3',
      '#3399ff', '#42a5f5', '#64b5f6', '#90caf9', '#bbdefb'].slice(0, etiquetasFiltradas.length);

    const canvas = document.getElementById('graficoClientesMes');
    if (!canvas) return;

    try {
      chartInstances.clientes = new Chart(canvas.getContext('2d'), {
        type: 'doughnut',
        data: { labels: etiquetasFiltradas, datasets: [{ data: valoresFiltrados, backgroundColor: colores, borderColor: '#bbbbbbff', borderWidth: 2, cutout: '40%' }] },
        options: { responsive: true, animation: { duration: 250 }, plugins: { legend: { display: false }, datalabels: { color: 'white', font: { weight: 'bold', size: 12 }, formatter: (value, context) => { const label = context.chart.data.labels[context.dataIndex]; return value > 0 ? `${label}: ${value}` : ''; }, display: (context) => context.dataset.data[context.dataIndex] > 0 } } },
        plugins: [ChartDataLabels]
      });
    } catch(e) { console.error('Error clientes:', e); }
  }

  function crearGaugeStock(data) {
    if (chartInstances.stock) chartInstances.stock.destroy();
    
    const porcentaje = data.porcentaje || 0;
    const totalSegmentos = 30;
    const segmentosActivos = Math.round((porcentaje / 100) * totalSegmentos);
    const azulClaro = [187, 222, 251]; 
    const azulOscuro = [13, 71, 161]; 
    const colores = Array.from({ length: totalSegmentos }, (_, i) => {
      if (i < segmentosActivos) {
        const t = i / (segmentosActivos - 1 || 1); 
        const r = Math.round(azulClaro[0] + (azulOscuro[0] - azulClaro[0]) * t);
        const g = Math.round(azulClaro[1] + (azulOscuro[1] - azulClaro[1]) * t);
        const b = Math.round(azulClaro[2] + (azulOscuro[2] - azulClaro[2]) * t);
        return `rgb(${r}, ${g}, ${b})`;
      }
      return '#616161';
    });

    const canvas = document.getElementById('gaugeSegmentado');
    if (!canvas) return;

    try {
      chartInstances.stock = new Chart(canvas, {
        type: 'doughnut',
        data: { datasets: [{ data: Array(totalSegmentos).fill(1), backgroundColor: colores, borderColor: '#2b2d3fff', borderWidth: 1, hoverOffset: 0 }] },
        options: { cutout: '65%', rotation: -90, circumference: 360, responsive: true, animation: { duration: 250 }, plugins: { legend: { display: false }, tooltip: { enabled: false } } }
      });
      const valorDiv = document.querySelector('.gauge-value');
      if (valorDiv) valorDiv.innerHTML = `Stock<br>${porcentaje}%`;
    } catch(e) { console.error('Error stock:', e); }
  }

  function crearGraficoVentas(data) {
    if (chartInstances.ventas) chartInstances.ventas.destroy();
    
    const canvas = document.getElementById('graficoVentas');
    if (!canvas) return;

    const azulClaro = [187, 222, 251];
    const azulOscuro = [13, 71, 161];
    const total = (data.valores || []).length;
    const colores = Array.from({ length: total }, (_, i) => {
      const t = i / (total - 1 || 1);
      const r = Math.round(azulClaro[0] + (azulOscuro[0] - azulClaro[0]) * t);
      const g = Math.round(azulClaro[1] + (azulOscuro[1] - azulClaro[1]) * t);
      const b = Math.round(azulClaro[2] + (azulOscuro[2] - azulClaro[2]) * t);
      return `rgb(${r}, ${g}, ${b})`;
    });

    try {
      chartInstances.ventas = new Chart(canvas.getContext('2d'), {
        type: 'bar',
        data: { labels: data.etiquetas || [], datasets: [{ label: 'Ventas (unidades)', data: data.valores || [], backgroundColor: colores, borderColor: colores, borderWidth: 0 }] },
        options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, animation: { duration: 250 }, plugins: { legend: { display: false }, datalabels: { align: 'start', anchor: 'end', color: 'white', formatter: (value, context) => context.chart.data.labels[context.dataIndex] + ' (' + value + ')', font: { size: 11, weight: 'bold' } } }, scales: { x: { beginAtZero: true, ticks: { color: 'white' }, grid: { color: 'rgba(255,255,255,0.1)' } }, y: { ticks: { display: false }, grid: { display: false } } } },
        plugins: [ChartDataLabels]
      });
    } catch(e) { console.error('Error ventas:', e); }
  }

  function crearGraficoPago(data) {
    if (chartInstances.pago) chartInstances.pago.destroy();
    
    const canvas = document.getElementById('graficoPago');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const scale = window.devicePixelRatio || 1;
    canvas.width = 500 * scale;
    canvas.height = 300 * scale;
    canvas.style.width = '500px';
    canvas.style.height = '300px';
    ctx.scale(scale, scale);

    try {
      chartInstances.pago = new Chart(ctx, {
        type: 'bar',
        data: { labels: data.etiquetas || [], datasets: [{ data: data.valores || [], backgroundColor: ['#0d47a1', '#1976d2', '#42a5f5', '#90caf9'], borderRadius: 4, borderSkipped: false }] },
        options: { responsive: false, animation: { duration: 250 }, plugins: { legend: { display: false }, tooltip: { enabled: false }, datalabels: { anchor: 'center', align: 'center', color: 'white', font: { family: 'Segoe UI', weight: 'bold', size: 28 }, formatter: v => v } }, scales: { y: { beginAtZero: true, ticks: { color: '#ffffff', font: { size: 18 } }, grid: { color: '#666' } }, x: { ticks: { color: '#ffffff', font: { size: 18 } }, grid: { color: '#666' } } } },
        plugins: [ChartDataLabels]
      });
    } catch(e) { console.error('Error pago:', e); }
  }

  function crearDoughnut(id, cantidad, label) {
    if (chartInstances[id]) chartInstances[id].destroy();
    
    const canvas = document.getElementById(id);
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const centroTexto = {
      id: 'centroTexto',
      beforeDraw(chart) {
        const { width, height } = chart;
        ctx.restore();
        ctx.font = 'bold 14px Poppins';
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(label, width / 2, height / 2 - 10);
        ctx.fillText(cantidad, width / 2, height / 2 + 10);
        ctx.save();
      }
    };

    try {
      chartInstances[id] = new Chart(ctx, {
        type: 'doughnut',
        data: { labels: ['Dato', 'Restante'], datasets: [{ data: [cantidad, 200 - cantidad], backgroundColor: ['#547AA5', '#1c2735'], borderColor: ['transparent', 'transparent'], borderWidth: 0 }] },
        options: { cutout: '85%', responsive: false, animation: { duration: 250 }, plugins: { legend: { display: false }, tooltip: { enabled: false } } },
        plugins: [centroTexto]
      });
    } catch(e) { console.error('Error doughnut:', e); }
  }
</script>



</body>
</html>