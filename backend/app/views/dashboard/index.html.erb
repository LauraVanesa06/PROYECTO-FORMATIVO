<section class="fondo">
  <section class="section-1">
    <div class="grafica-1">
      <section class="graf-1">
        <canvas id="graficoClientesMes"></canvas>
      </section>
      <section class="texto-1">
        <div class="titulo-1">Registros de clientes nuevos</div>
        <div class="texto-1-1">Este dato permite visualizar la evolución del negocio y el ritmo con el que se incrementa la cantidad
           de personas que acceden por primera vez a nuestros productos y servicios.</div>
      </section>
    </div>
    <div class="grafica-2">
      <section class="texto-2">
        <section class="texto-2-1"><div class="titulo-2">Ventas por categoría de producto</div>Este gráfico presenta la distribución de
          ventas por categorías de productos, permitiendo identificar cuáles generan mayores ingresos y aportan más al rendimiento general del negocio.
        </section>
        <div class="img-2">
          <canvas id="gaugeSegmentado"></canvas>
          <div class="gauge-value">Stock<br>90%</div>
        </div>
      </section>
      <section class="graf-2">
        <canvas id="graficoVentas" ></canvas>
      </section>
    </div>
    <div class="grafica-3">
      <section>
        <div class="ingresos">
          <p class="flecha" id="F1">🡅</p>
          <p class="etiqueta">Ingresos Totales</p>
          <p class="monto" id="ingresos">0$</p>
        </div>
      </section>
    </div>
  </section>

  <section class="section-2">
    <div class="grafica-4">
      <section class="graf-4-2">
        <div class="titulo-4-2">Ventas por Método de Pago</div>
        <canvas id="graficoPago"></canvas>
      </section>
    </div>
    <div class="grafica-5">
      <section class="texto-5"><div class="titulo-5">Ventas por día / semana / mes</div>Esta sección muestra el total de ventas realizadas durante el periodo 
      seleccionado (diario, semanal o mensual). La información permite identificar tendencias, evaluar el rendimiento y apoyar la toma de decisiones estratégicas.</section>

      <section class="graf-5">
        <!-- Dia -->
        <div class="grafico">
          <canvas id="grafDia" width="120" height="120"></canvas>
        </div>

        <!--Semana -->
        <div class="grafico">
          <canvas id="grafSemana" width="120" height="120"></canvas>
        </div>

        <!-- Mes -->
        <div class="grafico">
          <canvas id="grafMes" width="120" height="120"></canvas>
        </div>
      </section>
    </div>
  </section>
</section>

<script>
  // Sistema de caché para las gráficas del dashboard
  window.dashboardCache = window.dashboardCache || {
    data: {},
    charts: {},
    lastUpdate: {}
  };

  // Función para inicializar todos los gráficos del dashboard
  function initializeDashboardCharts() {
    console.log('📊 Inicializando gráficos del dashboard...');
    console.log('📦 Caché actual:', window.dashboardCache.data);

    // Si ya hay gráficos activos y caché tiene datos, NO recraar, solo redibujar
    if (window.Chart && window.Chart.instances && window.Chart.instances.length > 0 && Object.keys(window.dashboardCache.data).length > 0) {
      console.log('📊 Gráficos existentes encontrados, actualizando datos...');
      try {
        window.Chart.instances.forEach(chart => {
          if (chart && typeof chart.update === 'function') {
            chart.update();
            console.log('🔄 Gráfico actualizado:', chart.canvas.id);
          }
        });
      } catch (e) {
        console.warn('⚠️ Error actualizando gráficos:', e.message);
      }
      return; // Salir sin recrear
    }

    // SOLO si no hay gráficos previos: limpiar canvas y crear nuevos
    console.log('🧹 No hay gráficos previos, creando nuevos...');

    // Clientes por mes
    try {
      fetch('/api/v1/clientes_por_mes')
        .then(res => res.json())
        .then(data => {
          window.dashboardCache.data.clientesMes = data;
          window.dashboardCache.lastUpdate.clientesMes = Date.now();
          const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
          const valores = Object.values(data);
          const etiquetas = Object.keys(data).map(num => meses[parseInt(num) - 1]);
          const valoresFiltrados = valores.filter(v => v > 0);
          const etiquetasFiltradas = etiquetas.filter((_, i) => valores[i] > 0);
          const colores = ['#1e88e5', '#103f91', '#1565c0', '#1976d2', '#2196f3', '#3399ff', '#42a5f5', '#1e88e5', '#64b5f6', '#90caf9', '#bbdefb', '#e3f2fd'].slice(0, etiquetasFiltradas.length);
          const canvas = document.getElementById('graficoClientesMes');
          if (canvas) {
            const ctx = canvas.getContext('2d');
            new Chart(ctx, {
              type: 'doughnut',
              data: { labels: etiquetasFiltradas, datasets: [{ data: valoresFiltrados, backgroundColor: colores, borderColor: '#bbbbbbff', borderWidth: 2, cutout: '40%' }] },
              options: { plugins: { legend: { display: false }, datalabels: { color: 'white', font: { weight: 'bold', size: 14 }, formatter: (value, context) => { const label = context.chart.data.labels[context.dataIndex]; return value > 0 ? `${label}: ${value}` : ''; }, display: (context) => context.dataset.data[context.dataIndex] > 0 } } },
              plugins: [ChartDataLabels]
            });
          }
        })
        .catch(error => console.error("Error cargando clientes por mes:", error));
    } catch (e) {
      console.error('Error en clientes por mes:', e);
    }

    // Porcentaje Stock
    try {
      fetch('/api/v1/dashboard/porcentaje_stock')
        .then(res => res.json())
        .then(data => {
          window.dashboardCache.data.stock = data;
          window.dashboardCache.lastUpdate.stock = Date.now();
          const porcentaje = data.porcentaje;
          const totalSegmentos = 30;
          const segmentosActivos = Math.round((porcentaje / 100) * totalSegmentos);
          const datos = Array(totalSegmentos).fill(1);
          const azulClaro = [187, 222, 251]; 
          const azulOscuro = [13, 71, 161]; 
          const colores = Array.from({ length: totalSegmentos }, (_, i) => {
            if (i < segmentosActivos) {
              const t = i / (segmentosActivos - 1 || 1); 
              const r = Math.round(azulClaro[0] + (azulOscuro[0] - azulClaro[0]) * t);
              const g = Math.round(azulClaro[1] + (azulOscuro[1] - azulClaro[1]) * t);
              const b = Math.round(azulClaro[2] + (azulOscuro[2] - azulClaro[2]) * t);
              return `rgb(${r}, ${g}, ${b})`;
            } else {
              return '#616161';
            }
          });
          const gaugeCanvas = document.getElementById('gaugeSegmentado');
          if (gaugeCanvas) {
            new Chart(gaugeCanvas, {
              type: 'doughnut',
              data: { datasets: [{ data: datos, backgroundColor: colores, borderColor: '#2b2d3fff', borderWidth: 1.5, hoverOffset: 0 }] },
              options: { cutout: '65%', rotation: -90, circumference: 360, plugins: { legend: { display: false }, tooltip: { enabled: false } } }
            });
          }
          const valorDiv = document.querySelector('.gauge-value');
          if (valorDiv) valorDiv.innerHTML = `Stock<br>${porcentaje}%`;
        })
        .catch(error => console.error("Error cargando porcentaje de stock:", error));
    } catch (e) {
      console.error('Error en stock:', e);
    }

    // Ventas por categoría
    try {
      fetch('/api/v1/ventas_por_categoria')
        .then(res => res.json())
        .then(data => {
          window.dashboardCache.data.ventasCategoria = data;
          window.dashboardCache.lastUpdate.ventasCategoria = Date.now();
          const canvas = document.getElementById('graficoVentas');
          if (canvas) {
            const ctx2 = canvas.getContext('2d');
            const azulClaro = [187, 222, 251];
            const azulOscuro = [13, 71, 161];
            const total = data.valores.length;
            const colores = Array.from({ length: total }, (_, i) => {
              const t = i / (total - 1 || 1);
              const r = Math.round(azulClaro[0] + (azulOscuro[0] - azulClaro[0]) * t);
              const g = Math.round(azulClaro[1] + (azulOscuro[1] - azulClaro[1]) * t);
              const b = Math.round(azulClaro[2] + (azulOscuro[2] - azulClaro[2]) * t);
              return `rgb(${r}, ${g}, ${b})`;
            });
            new Chart(ctx2, {
              type: 'bar',
              data: { labels: data.etiquetas, datasets: [{ label: 'Ventas (unidades)', data: data.valores, backgroundColor: colores, borderColor: colores, borderWidth: 1 }] },
              options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, datalabels: { align: 'start', anchor: 'end', color: 'white', formatter: (value, context) => context.chart.data.labels[context.dataIndex] + ' (' + value + ')', font: { size: 12, weight: 'bold' } } }, scales: { x: { beginAtZero: true, ticks: { color: 'white' }, title: { display: true, text: 'Unidades vendidas', color: 'white' }, grid: { color: 'rgba(255,255,255,0.1)' } }, y: { ticks: { display: false }, grid: { display: false } } } },
              plugins: [ChartDataLabels]
            });
          }
        })
        .catch(err => console.error('Error al cargar ventas por categoría:', err));
    } catch (e) {
      console.error('Error en ventas por categoría:', e);
    }

    // Finanzas
    try {
      function formatearPesos(valor) {
        if (!valor || isNaN(valor)) return '$0';
        return `$${valor.toLocaleString("es-CO")}`;
      }
      fetch('/api/v1/finanzas')
        .then(res => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        })
        .then(data => {
          window.dashboardCache.data.finanzas = data;
          window.dashboardCache.lastUpdate.finanzas = Date.now();
          if (data && data.ingresos !== null && data.ingresos !== undefined) {
            const ingresosEl = document.getElementById("ingresos");
            if (ingresosEl) ingresosEl.textContent = formatearPesos(data.ingresos);
          } else {
            console.warn('⚠️ Datos de ingresos no válidos:', data);
          }
        })
        .catch(err => console.error("Error al cargar datos financieros:", err));
    } catch (e) {
      console.error('Error en finanzas:', e);
    }

    // Ventas por tipo de pago
    try {
      const canvas = document.getElementById('graficoPago');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        const scale = window.devicePixelRatio || 1;
        const visibleWidth = 500;
        const visibleHeight = 300;
        canvas.width = visibleWidth * scale;
        canvas.height = visibleHeight * scale;
        canvas.style.width = visibleWidth + 'px';
        canvas.style.height = visibleHeight + 'px';
        ctx.scale(scale, scale);

        fetch('/api/v1/buys/ventas_por_tipo')
          .then(res => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.json();
          })
          .then(data => {
            window.dashboardCache.data.ventasTipo = data;
            window.dashboardCache.lastUpdate.ventasTipo = Date.now();
            console.log('📊 Datos de ventas por tipo:', data);
            if (!data.etiquetas || !data.valores) {
              throw new Error('Formato de datos incorrecto');
            }
            new Chart(ctx, {
              type: 'bar',
              data: { labels: data.etiquetas, datasets: [{ data: data.valores, backgroundColor: ['#0d47a1', '#1976d2', '#42a5f5', '#90caf9'], borderRadius: 5, borderSkipped: false }] },
              options: { responsive: false, plugins: { legend: { display: false }, tooltip: { enabled: false }, datalabels: { anchor: 'center', align: 'center', color: 'white', font: { family: 'Segoe UI', weight: 'bold', size: 30 }, formatter: function(value) { return value; } } }, scales: { y: { beginAtZero: true, ticks: { color: '#ffffff', font: { size: 20 } }, grid: { color: '#666' } }, x: { ticks: { color: '#ffffff', font: { size: 20 } }, grid: { color: '#666' } } } },
              plugins: [ChartDataLabels]
            });
            console.log('✅ Gráfico de ventas por tipo cargado');
          })
          .catch(err => console.error('Error al cargar datos de pagos:', err));
      } else {
        console.warn('⚠️ Canvas graficoPago no encontrado');
      }
    } catch (e) {
      console.error('Error en pagos:', e);
    }

    // Función para crear doughnut de período
    function crearDoughnut(id, cantidad, label) {
      try {
        const canvasElement = document.getElementById(id);
        if (!canvasElement) {
          console.warn(`Canvas ${id} no encontrado`);
          return;
        }
        
        const ctx = canvasElement.getContext('2d');
        const centroTexto = {
          id: 'centroTexto',
          beforeDraw(chart) {
            const { width, height } = chart;
            const ctx = chart.ctx;
            ctx.restore();
            const fontSize = 16;
            ctx.font = `bold ${fontSize}px Poppins`;
            ctx.fillStyle = '#ffffff';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(label, width / 2, height / 2 - 10);
            ctx.fillText(cantidad, width / 2, height / 2 + 10);
            ctx.save();
          }
        };
        new Chart(ctx, {
          type: 'doughnut',
          data: { labels: ['Dato', 'Restante'], datasets: [{ data: [cantidad, 200 - cantidad], backgroundColor: ['#547AA5', '#1c2735'], borderColor: ['transparent', 'transparent'], borderWidth: 2 }] },
          options: { cutout: '85%', responsive: false, plugins: { legend: { display: false }, tooltip: { enabled: false } } },
          plugins: [centroTexto]
        });
      } catch (e) {
        console.error(`Error creando doughnut ${id}:`, e);
      }
    }

    // Ventas por período
    try {
      fetch('/api/v1/ventas_periodo')
        .then(res => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        })
        .then(data => {
          window.dashboardCache.data.ventasPeriodo = data;
          window.dashboardCache.lastUpdate.ventasPeriodo = Date.now();
          console.log('📊 Datos de período recibidos:', data);
          crearDoughnut('grafDia', data.dia, 'Día');
          crearDoughnut('grafSemana', data.semana, 'Semana');
          crearDoughnut('grafMes', data.mes, 'Mes');
        })
        .catch(error => console.error('Error al cargar ventas por periodo:', error));
    } catch (e) {
      console.error('Error en período:', e);
    }

    console.log('✅ initializeDashboardCharts completada');
    console.log('💾 Caché actualizado:', window.dashboardCache);
  }

  // Inicializar en carga inicial
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeDashboardCharts);
  } else {
    initializeDashboardCharts();
  }

  // Reinicializar cuando se carga dinámicamente
  document.addEventListener('dashboard:content-loaded', initializeDashboardCharts);
</script>