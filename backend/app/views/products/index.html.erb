<section class="section-container">
  <button class="hamburger-categorias" id="hamburger-categorias"></button>

  <aside class="categorias" id="menu-categorias">
    <div class="div-div">
      <a href="productos" class="div-categ" style="text-decoration:none;"><i class="fas fa-arrow-left" id="vol"></i></a>
      <div class="div-categ">Categorias:</div>
      <a href="#modal-new-category" class="new-categ">+</a>
    </div>
      <% @categories.each do |category| %>
        <%= render category %>
      <% end %>
  </aside>

  <section class="section-product">
    <nav class="nav-filtros">
      <p class=p><i class="fas fa-filter"></i> Filtro</p>
      <%= form_with url: inventario_path, method: :get, local: true, class:"form-filtros" do %>
        <ul>
          <li>
            <%= label_tag :cod, "Codigo:" %>
            <%= text_field_tag :cod, params[:cod], placeholder: "Ej: MG001", style:"width: 100px; box-sizing: border-box; border-radius:10px; padding-left: 10px; border:1px solid grey;"%> 
          </li>
          <li>
            <%= label_tag :name, "Nombre:" %>
            <%= text_field_tag :name, params[:name], placeholder: "Ej: Martillo", style:"width: 163px; border-radius:10px; padding-left: 10px; border:1px solid grey;"%> 
          </li>
          <li class="li-precio">
            <label for="toggle-precio" class="a-precio">Rango de Precio ▾</label>
            <input type="checkbox" id="toggle-precio" hidden>

            <ul class="ul-precio">
              <li>
                <%= label_tag :min, "Mínimo:", class: "preci"%>
                <%= text_field_tag :min, params[:min], id: "min",
                  oninput: "this.value = this.value.replace(/[^0-9.]/g, '')",
                  style:"width: 80px; border-radius:10px; padding-left: 10px; border: grey" %>
              </li>
              <li>
                <%= label_tag :max, "Máximo:", class: "preci"%>
                <%= text_field_tag :max, params[:max], id: "max",
                  oninput: "this.value = this.value.replace(/[^0-9.]/g, '')",
                  style:"width: 80px; border-radius:10px; padding-left: 10px; border: grey" %>
              </li>
            </ul>
          </li>
          <li class="li-marca">
            <label for="toggle-marca" class="a-marca">Proveedor ▾</label>
            <input type="checkbox" id="toggle-marca" hidden>

            <ul class="ul-marca">
              <% @suppliers.each do |supplier| %>
                <li>
                  <input type="checkbox" id="supplier_<%= supplier.id %>" name="suppliers[]" value="<%= supplier.id %>" 
                  <%= "checked" if params[:suppliers]&.include?(supplier.id.to_s) %>>

                  <label for="supplier_<%= supplier.id %>"><%= supplier.nombre %></label>
                </li>
              <% end %>
            </ul>
          </li>
          <li>
            <button id="limpiar-filtros" type="button" class="lupa">
              <i class="fas fa-broom"></i>
            </button>
          </li>
          <li>
            <%= button_tag type: 'submit', class: 'lupa', name: '' do %>
              <i class="fas fa-search"></i>
            <% end %>
          </li>
          <li>
            <a href="#modal-new-category" class="lupa" title="Crear nueva categoría">
              <i class="fas fa-plus"></i>
            </a>
          </li>
        </ul>
      <% end %>
    </nav>

    <section class="section-models">
      <% if flash[:alert] %>
        <div id="mensaje-alerta" class="alerta-filtro">
          <%= flash[:alert] %>
        </div>

        <script>
          setTimeout(() => {
            const alerta = document.getElementById("mensaje-alerta");
            if (alerta) alerta.style.display = "none";
          }, 4000);
        </script>
      <% end %>

      <% if @products.present? %>
        <% @products.each do |product| %>
          <%= render product %>
        <% end %>
      <% end %>

      <%= link_to "+", new_product_path, class: "new-prod" %>
    </section>

    <!-- MODAL NUEVA CATEGORÍA -->
    <div id="modal-new-category" class="modal">
      <div class="modal-content2">
        <a href="#" class="close">&times;</a>
        <div class="titulo2 tc">Crear Categoría</div>
        <%= render 'categories/form', category: Category.new %>
      </div>
    </div>
  </section>
</section>
  <script>
    const btn = document.getElementById("hamburger");
    const menu = document.getElementById("menu");

    if (btn && menu) {
      btn.addEventListener("click", () => {
        menu.classList.toggle("active");
      });
    }

    const btnCategorias = document.getElementById("hamburger-categorias");
    const menuCategorias = document.getElementById("menu-categorias");

    if (btnCategorias && menuCategorias) {
      btnCategorias.addEventListener("click", () => {
        menuCategorias.classList.toggle("active");
      });
    }

    document.addEventListener("DOMContentLoaded", function () {
      const botonLimpiar = document.getElementById("limpiar-filtros");

      if (botonLimpiar) {
        botonLimpiar.addEventListener("click", function () {
          const form = botonLimpiar.closest("form");

          if (form) {
            const inputs = form.querySelectorAll("input, select, textarea");
            inputs.forEach((input) => {
              if (input.type === "checkbox" || input.type === "radio") {
                input.checked = false;
              } else {
                input.value = "";
              }
            });

            setTimeout(() => {
              const urlSinParametros = window.location.origin + window.location.pathname;
              window.location.href = urlSinParametros;
            }, 100);
          }
        });
      }
    });
  </script>

